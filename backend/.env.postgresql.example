# Variables d'environnement pour Render avec PostgreSQL
# Render fournira automatiquement DATABASE_URL

# Option 1: DATABASE_URL (fourni automatiquement par Render avec PostgreSQL)
# postgres://user:password@host:port/database

# Option 2: Variables individuelles (si vous n'utilisez pas le service Render PostgreSQL)
DB_TYPE=postgresql
DB_HOST=postgres.render.com
DB_PORT=5432
DB_NAME=bugoupas
DB_USER=bugoupas_user
DB_PASS=votre_mot_de_passe

# Mot de passe admin (hash bcrypt)
ADMIN_PASSWORD_HASH=$2y$12$WMni5c94Bf21j06HAE8mUeLJ0.013z7FUzk8HR3.jxkN7AbvNJmCo

# URL de votre frontend (pour CORS)
CORS_ORIGIN=https://votre-frontend.vercel.app
