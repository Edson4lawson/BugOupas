# Variables d'environnement pour Render
# Copiez ces variables dans Render Dashboard → votre service → Environment

# Configuration MySQL (depuis votre hébergeur MySQL externe)
DB_HOST=sqlXXX.epizy.com
DB_NAME=votre_base_de_donnees
DB_USER=votre_utilisateur
DB_PASS=votre_mot_de_passe

# Mot de passe admin (hash bcrypt - utilisez la valeur par défaut ou générez-en un nouveau)
ADMIN_PASSWORD_HASH=$2y$12$WMni5c94Bf21j06HAE8mUeLJ0.013z7FUzk8HR3.jxkN7AbvNJmCo

# URL de votre frontend (pour CORS)
CORS_ORIGIN=https://votre-frontend.vercel.app
