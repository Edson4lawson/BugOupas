# Activer le moteur de réécriture
RewriteEngine On

# Permettre l'accès CORS (Géré dynamiquement par PHP dans config.php)
# Header set Access-Control-Allow-Origin "*"
# Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
# Header set Access-Control-Allow-Headers "Content-Type, Authorization"

# Gérer les requêtes OPTIONS (Laisser PHP gérer via config.php pour avoir les bons headers)
# RewriteCond %{REQUEST_METHOD} OPTIONS
# RewriteRule ^(.*)$ $1 [R=200,L]

# Sécurité - Empêcher l'accès direct aux fichiers de configuration
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>
